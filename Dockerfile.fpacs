# fpacs-ohif — imagen custom con PUBLIC_URL=/ohif/ + mobile CSS overrides.
# Build context = ./ (con Viewers/dist/ ya construido).
# 1.30.x estable con soporte (CVE nginx 2026-10-14); antes 1.27. El comentario va en su propia línea:
# Dockerfile no admite comentarios al final de una instrucción (el FROM con comentario inline rompía el build).
FROM nginx:1.30-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx-fpacs.conf /etc/nginx/conf.d/default.conf
COPY platform/app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
